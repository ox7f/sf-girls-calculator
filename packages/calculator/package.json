{
  "name": "sf-girls-calculator-calculator",
  "author": "ox7f",
  "license": "ISC",
  "private": true,
  "version": "0.0.1",
  "description": "math stuff",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "npm run build && node dist/index.js",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint ./calculator/**/*",
    "typecheck": "tsc -b",
    "format": "prettier --write calculator"
  },
  "devDependencies": {
    "@types/node": "^14.0.25",
    "@typescript-eslint/eslint-plugin": "^5.46.1",
    "@typescript-eslint/parser": "^5.46.1",
    "eslint": "^8.30.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.8.2",
    "ts-node": "^9.0.0",
    "typescript": "^4.9.3"
  },
  "source": "calculator/index.ts",
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "printWidth": 120
  }
}

